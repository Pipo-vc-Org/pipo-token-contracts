{
  "name": "pipo-token-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Non-upgradeable ERC20 security token and compliance policy for the PIPO platform",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@9.1.1",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "cross-env REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "lint": "solhint \"contracts/**/*.sol\"",
    "typecheck": "tsc --noEmit",
    "clean": "hardhat clean"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "chai": "^4.5.0",
    "cross-env": "^10.1.0",
    "ethers": "^6.17.0",
    "hardhat": "^2.28.6",
    "hardhat-gas-reporter": "^2.2.2",
    "solhint": "^5.0.3",
    "solidity-coverage": "^0.8.14",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "cookie": "^0.7.0",
    "serialize-javascript": "^7.0.5",
    "tmp": "^0.2.6",
    "hardhat": {
      "undici": "^6.27.0",
      "uuid": "^11.1.1"
    }
  }
}
